/* Screen Help (canvas Help.dc.html): three columns, flat surfaces, section list on the left */
QWidget#helpPage { background: $base; }
QFrame#helpHeader { background: $base; border: 0; border-bottom: 1px solid $divider_inner; border-radius: 0; }
QFrame#helpNav { background: $surface; border: 0; border-right: 1px solid $divider; border-radius: 0; }
QFrame#helpAside { background: $surface; border: 0; border-left: 1px solid $divider; border-radius: 0; }
QScrollArea#helpScroll { background: $base; border: 0; }
QScrollArea#helpScroll > QWidget > QWidget { background: $base; }
QPushButton[helpItem="true"] { background: transparent; border: 0; border-radius: ${radius_control}px; color: $text; text-align: left; min-height: 16px; padding: 8px 10px; font-size: ${font_control}px; font-weight: 500; }
QPushButton[helpItem="true"]:hover { background: $hover; }
QPushButton[helpItem="true"]:checked { background: $selected; color: $on_selected; }
QPushButton[helpItem="true"]:focus { border: 2px solid $ring; }
