{
  "sf_cli": {
    "path": "",
    "search_paths": [
      "/Applications/Screaming Frog SEO Spider.app/Contents/MacOS/ScreamingFrogSEOSpiderLauncher",
      "/Applications/Screaming Frog SEO Spider.app/Contents/MacOS/ScreamingFrogSEOSpiderCli",
      "/usr/bin/screamingfrogseospider",
      "C:\\Program Files (x86)\\Screaming Frog SEO Spider\\ScreamingFrogSEOSpiderCli.exe",
      "C:\\Program Files\\Screaming Frog SEO Spider\\ScreamingFrogSEOSpiderCli.exe"
    ],
    "seospiderconfig": "audit.seospiderconfig",
    "export_format": "csv",
    "timeout_minutes": 30,
    "expected_urls": 0,
    "max_urls_per_second": null
  },
  "profile": "full",
  "exports": {
    "tabs": [
      "Internal:All",
      "Response Codes:Client Error (4xx)",
      "Response Codes:Server Error (5xx)",
      "Response Codes:Redirection (3xx)",
      "Sitemaps:URLs in Sitemap",
      "Sitemaps:URLs not in Sitemap",
      "Sitemaps:Orphan URLs",
      "Sitemaps:Non-Indexable URLs in Sitemap",
      "Page Titles:Multiple",
      "Structured Data:Validation Errors",
      "Structured Data:Validation Warnings",
      "Security:Mixed Content",
      "Images:Missing Alt Text",
      "Images:Missing Size Attributes",
      "JavaScript:All",
      "Canonicals:All",
      "H1:All",
      "Hreflang:Non-200 hreflang URLs",
      "Page Titles:Duplicate",
      "Meta Description:Duplicate",
      "Images:Over X KB",
      "Security:Missing HSTS Header",
      "Structured Data:Missing",
      "Response Codes:No Response",
      "Response Codes:Blocked by Robots.txt"
    ],
    "bulk": [
      "Response Codes:Internal & External:Client Error (4xx) Inlinks",
      "Response Codes:Internal & External:Server Error (5xx) Inlinks",
      "Response Codes:Internal & External:Redirection (3xx) Inlinks"
    ],
    "reports": [
      "Redirects:Redirect Chains",
      "Hreflang:All hreflang URLs"
    ],
    "fetch_all_inlinks": false
  },
  "input": {
    "mode": "auto",
    "exports_dir": "exports",
    "html_store_dir": null,
    "lighthouse_reports": {}
  },
  "semantic_similarity": {
    "adapter": null,
    "embeddings": [],
    "cache_path": null,
    "threshold": 0.82,
    "relevance_threshold": 0.35,
    "max_documents": 1000,
    "max_candidate_comparisons": 250000
  },
  "filters": {
    "content_type_include": [
      "text/html"
    ],
    "exclude_extensions": [
      ".js",
      ".css",
      ".json",
      ".xml",
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp",
      ".svg",
      ".pdf",
      ".woff",
      ".woff2",
      ".ttf",
      ".eot",
      ".ico"
    ]
  },
  "thresholds": {
    "title_max_chars": 60,
    "title_max_px": 561,
    "title_min_chars": 30,
    "desc_max_chars": 160,
    "desc_max_px": 985,
    "desc_min_chars": 70,
    "h1_max_chars": 70,
    "thin_content_words": 200,
    "low_text_ratio_pct": 10,
    "url_max_chars": 115,
    "crawl_depth_max": 4,
    "click_depth_max": 10,
    "orphan_inlinks_min": 1,
    "response_time_max_s": 1.5,
    "large_html_abs_kb": 200,
    "large_html_x_median": 3.0,
    "dom_depth_max": 32,
    "dom_nodes_max": 1500,
    "img_max_kb": 150,
    "page_weight_max_bytes": 2097152,
    "resource_max_bytes": 2097152,
    "sitemap_lastmod_stale_days": 365,
    "sitemap_desync_pct_warn": 20,
    "templated_title_share": 0.6,
    "bytes_per_word_x_median": 4.0,
    "readability_flesch_min": 30,
    "avg_words_per_sentence_max": 25,
    "high_external_outlinks": 100,
    "high_outlinks": 300,
    "redirect_hop_cap": 20,
    "link_score_low_ratio": 0.25,
    "near_duplicate_similarity": 0.92
  },
  "requirements": {
    "require_canonical": true,
    "require_h2": false,
    "require_hreflang": false,
    "require_structured_data": false,
    "require_og": false
  },
  "canonical_policy": {
    "pagination": [],
    "filters": []
  },
  "live_recheck": {
    "enabled": false,
    "use": "auto",
    "user_agent": "Mozilla/5.0 (compatible; SEOHEAD-Tools/3.0; +https://seohead.tech/seotools)",
    "max_urls": 5000,
    "timeout_s": 10
  },
  "tasks_pipeline": {
    "include_severities": [
      "critical",
      "warning",
      "notice"
    ],
    "group_by": "check",
    "priority_map": {
      "critical": "P1",
      "warning": "P2",
      "notice": "P3"
    },
    "effort_map": {
      "critical": "high",
      "warning": "medium",
      "notice": "low"
    },
    "max_urls_per_task": 25,
    "min_occurrences": 1,
    "include_checks": [],
    "exclude_checks": [],
    "assignments": []
  },
  "checks": {},
  "severity_overrides": {},
  "finding_exclusions": [],
  "scoring": {
    "weights": {
      "critical": 5,
      "warning": 2,
      "notice": 0.5
    }
  },
  "output": {
    "json_path": "audit.json",
    "md_path": "audit.md",
    "keep_raw_exports": true,
    "max_locations_per_issue": 200,
    "max_pages_in_json": 100000
  }
}
