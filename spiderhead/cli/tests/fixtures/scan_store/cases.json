 {
  "id": "extract-headings",
  "command": "scan-extract",
  "tool": "seo_scan_extract",
  "args": {
   "input_path": "{SCAN}",
   "rules": [
    {
     "id": "h1",
     "kind": "text",
     "selector": "h1",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "h2",
     "kind": "text",
     "selector": "h2",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "h3",
     "kind": "text",
     "selector": "h3",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "h4",
     "kind": "text",
     "selector": "h4",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "h5",
     "kind": "text",
     "selector": "h5",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "h6",
     "kind": "text",
     "selector": "h6",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "heading-count",
     "kind": "count",
     "selector": "h1,h2,h3,h4,h5,h6",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    }
   ]
  },
  "sites": [
   "basic",
   "errors",
   "redirects",
   "canonical-hreflang",
   "schema",
   "robots-sitemap"
  ]
 },
 {
  "id": "extract-meta",
  "command": "scan-extract",
  "tool": "seo_scan_extract",
  "args": {
   "input_path": "{SCAN}",
   "rules": [
    {
     "id": "title",
     "kind": "text",
     "selector": "title",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "description",
     "kind": "attribute",
     "selector": "meta[name=\"description\"]@content",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "meta-robots",
     "kind": "attribute",
     "selector": "meta[name=\"robots\"]@content",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "canonical",
     "kind": "attribute",
     "selector": "link[rel=\"canonical\"]@href",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    }
   ],
   "limit": 3
  },
  "sites": [
   "basic",
   "schema"
  ]
 },
 {
  "id": "extract-links",
  "command": "scan-extract",
  "tool": "seo_scan_extract",
  "args": {
   "input_path": "{SCAN}",
   "rules": [
    {
     "id": "a-href",
     "kind": "attribute",
     "selector": "a@href",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "a-text",
     "kind": "text",
     "selector": "a",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "a-rel",
     "kind": "attribute",
     "selector": "a@rel",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "a-external",
     "kind": "attribute",
     "selector": "a[href^=\"http\"]@href",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "a-nofollow",
     "kind": "count",
     "selector": "a[rel~=\"nofollow\"]",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    }
   ],
   "url": "{START}"
  },
  "sites": [
   "basic"
  ]
 },
 {
  "id": "extract-images",
  "command": "scan-extract",
  "tool": "seo_scan_extract",
  "args": {
   "input_path": "{SCAN}",
   "rules": [
    {
     "id": "img-src",
     "kind": "attribute",
     "selector": "img@src",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "img-alt",
     "kind": "attribute",
     "selector": "img@alt",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "img-alt-empty",
     "kind": "count",
     "selector": "img[alt=\"\"]",
     "operator": "exists",
     "value": "",
     "max_matches": 100
    },
    {
     "id": "img-alt-missing",
