[
 {
  "id": "navigation",
  "command": "scan-navigation",
  "tool": "seo_scan_navigation",
  "sites": [
   "basic",
   "errors"
  ],
  "args": {
   "input_path": "{SCAN}"
  }
 },
 {
  "id": "navigation-bad-limit",
  "command": "scan-navigation",
  "tool": "seo_scan_navigation",
  "args": {
   "input_path": "{SCAN}",
   "limit": 0
  }
 },
 {
  "id": "rendered-routes",
  "command": "scan-rendered-routes",
  "tool": "seo_scan_rendered_routes",
  "sites": [
   "basic",
   "redirects"
  ],
  "args": {
   "input_path": "{SCAN}"
  }
 },
 {
  "id": "config-diff",
  "command": "scan-config-diff",
  "tool": "seo_scan_config_diff",
  "sites": [
   "basic"
  ],
  "args": {
   "before_path": "{SCAN}",
   "after_path": "{SCAN2}"
  }
 },
 {
  "id": "extraction-presets",
  "command": "extraction-presets",
  "tool": "seo_extraction_presets",
  "args": {}
 },
 {
  "id": "pin",
  "command": "scan-pin",
  "tool": "seo_scan_pin",
  "args": {
   "input_path": "{SCAN}"
  },
  "then": [
   {
    "command": "scan-pin",
    "tool": "seo_scan_pin",
    "args": {
     "input_path": "{SCAN}",
     "pinned": false
    }
   }
  ]
 },
 {
  "id": "snapshot",
  "command": "scan-snapshot",
  "tool": "seo_scan_snapshot",
  "args": {
   "input_path": "{SCAN}",
   "out": "{WORK}/snap.sqlite"
  },
  "then": [
   {
    "command": "scan-status",
    "tool": "seo_scan_status",
    "args": {
     "input_path": "{WORK}/snap.sqlite"
    }
   }
  ]
 },
 {
  "id": "body-diff",
  "command": "scan-body-diff",
  "tool": "seo_scan_body_diff",
  "args": {
   "left": "{SCAN}",
   "right": "{SCAN2}",
   "url": "{BASE}/about.html",
   "text": true
  }
 },
 {
  "id": "archive",
  "command": "scan-archive",
  "tool": "seo_scan_archive",
  "sites": [
   "basic",
   "errors"
  ],
  "args": {
   "input_path": "{SCAN}",
   "out": "{WORK}/a.warc"
  },
  "collect": [
   "a.warc"
  ]
 },
 {
  "id": "sitemap-generate",
  "command": "scan-sitemap-generate",
  "tool": "seo_scan_sitemap_generate",
  "sites": [
   "basic",
   "robots-sitemap"
  ],
  "args": {
   "input_path": "{SCAN}",
   "out_dir": "{WORK}/sm",
   "sitemap_base_url": "https://example.com",
   "include_images": true
  },
  "collect": [
   "sm"
  ]
 },
 {
  "id": "sitemap-generate-exclude",
  "command": "scan-sitemap-generate",
  "tool": "seo_scan_sitemap_generate",
  "args": {
   "input_path": "{SCAN}",
   "out_dir": "{WORK}/sm",
   "sitemap_base_url": "https://example.com",
   "exclude": [
    "*/about*"
   ]
  },
  "collect": [
   "sm"
  ]
 },
 {
  "id": "requeue",
  "command": "scan-requeue",
  "tool": "seo_scan_requeue",
  "sites": [
   "errors"
  ],
  "args": {
   "input_path": "{SCAN}",
   "where": "status_code >= 400",
   "backup_path": "{WORK}/backup.sqlite"
  },
  "then": [
   {
    "command": "scan-status",
    "tool": "seo_scan_status",
    "args": {
     "input_path": "{SCAN}"
    }
   }
  ]
 },
 {
  "id": "requeue-bad-where",
  "command": "scan-requeue",
  "tool": "seo_scan_requeue",
  "args": {
   "input_path": "{SCAN}",
   "where": "1=1",
   "backup_path": "{WORK}/backup.sqlite"
  }
 },
 {
  "id": "import-urls",
  "command": "scan-import-urls",
  "tool": "seo_scan_import_urls",
  "sites": [
   "basic"
  ],
  "files_in": {
   "urls.txt": "{BASE}/new-a.html\n{BASE}/new-b.html\nhttps://other.example.org/x\n"
  },
  "args": {
   "input_path": "{SCAN}",
   "urls_file": "{WORK}/urls.txt",
   "backup_path": "{WORK}/backup.sqlite"
  },
  "then": [
   {
    "command": "scan-status",
    "tool": "seo_scan_status",
    "args": {
     "input_path": "{SCAN}"
    }
   }
  ]
 },
 {
  "id": "prune-preview",
  "command": "scan-prune",
  "tool": "seo_scan_prune",
  "args": {
   "directory": "{WORK}",
   "older_than_days": 0,
   "keep_newest": 0
  }
 },
 {
  "id": "prune-apply-no-plan",
  "command": "scan-prune",
  "tool": "seo_scan_prune",
  "args": {
   "directory": "{WORK}",
   "apply": true
  }
 },
 {
  "id": "body-diff-missing",
  "command": "scan-body-diff",
  "tool": "seo_scan_body_diff",
  "args": {
   "left": "{SCAN}",
   "right": "{SCAN2}",
   "url": "{BASE}/nope.html"
  }
 },
 {
  "id": "custom-extract",
  "command": "custom-extract-sample",
  "tool": "seo_custom_extract_sample",
  "args": {
   "html": "<html><body><h1>Hi</h1><p class='x'>a</p><p class='x'>b</p></body></html>",
   "extractors": [
    {
     "name": "h1",
     "query": "h1"
    },
    {
     "name": "xs",
     "mode": "css",
     "query": "p.x",
     "output": "text"
    },
    {
     "name": "none",
     "query": "table"
    }
   ],
   "url": "https://example.com/"
  }
 },
 {
  "id": "custom-extract-empty",
  "command": "custom-extract-sample",
  "tool": "seo_custom_extract_sample",
  "args": {
   "html": "",
   "extractors": [
    {
     "name": "h1",
     "query": "h1"
    }
   ]
  }
 },
 {
  "id": "custom-extract-bad",
  "command": "custom-extract-sample",
  "tool": "seo_custom_extract_sample",
  "args": {
   "html": "<p>x",
   "extractors": [
    {
     "name": "",
     "query": "p"
    }
   ]
  }
 },
