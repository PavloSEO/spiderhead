  {
   "name": "gsc-inspect",
   "cli": {
    "argv": [
     "gsc-query",
     "--site-url",
     "sc-domain:example.test",
     "--mode",
     "inspect_url",
     "--inspection-url",
     "https://example.test/a"
    ]
   },
   "mcp": {
    "tool": "seo_gsc_query",
    "arguments": {
     "site_url": "sc-domain:example.test",
     "mode": "inspect_url",
     "inspection_url": "https://example.test/b"
    }
   },
   "seed": [
    {
     "path": ".config/gsc/access_token",
     "text": "test-gsc-token"
    }
   ],
   "routes": [
    {
     "host": "searchconsole.googleapis.com",
     "method": "POST",
     "path": "/v1/urlInspection/index:inspect",
     "responses": [
      {
       "status": 200,
       "headers": {
        "content-type": "application/json"
       },
       "body": {
        "inspectionResult": {
         "indexStatusResult": {
          "verdict": "PASS",
          "coverageState": "Submitted and indexed",
          "indexingState": "INDEXING_ALLOWED",
          "lastCrawlTime": "2026-01-01T00:00:00Z",
          "googleCanonical": "https://example.test/a",
          "userCanonical": "https://example.test/a"
         }
        }
       }
      }
     ]
    }
   ],
   "expect": {
    "cli": {
     "exit": 0,
     "stdout": "{\n  \"ok\": true,\n  \"site_url\": \"sc-domain:example.test\",\n  \"inspection_url\": \"https://example.test/a\",\n  \"verdict\": \"PASS\",\n  \"coverage_state\": \"Submitted and indexed\",\n  \"indexing_state\": \"INDEXING_ALLOWED\",\n  \"last_crawl_time\": \"<TS>\",\n  \"google_canonical\": \"https://example.test/a\",\n  \"user_canonical\": \"https://example.test/a\"\n}\n",
     "stderr": "seohead: gsc-query\n",
     "requests": [
      {
       "host": "searchconsole.googleapis.com",
       "method": "POST",
       "path": "/v1/urlInspection/index:inspect",
       "query": "",
       "body": "{\"inspectionUrl\": \"https://example.test/a\", \"siteUrl\": \"sc-domain:example.test\"}",
       "headers": {
        "authorization": "Bearer test-gsc-token",
        "content-type": "application/json"
       }
      }
     ]
    },
    "mcp": {
