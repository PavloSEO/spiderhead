  {
   "name": "gsc-inspect-needs-url",
   "cli": {
    "argv": [
     "gsc-query",
     "--site-url",
     "sc-domain:example.test",
     "--mode",
     "inspect_url"
    ]
   },
   "expect": {
    "cli": {
     "exit": 1,
     "stdout": "",
     "stderr": "seohead: gsc-query\nerror: inspection_url required for mode=inspect_url\n",
     "requests": []
    }
   }
  },
  {
   "name": "gsc-bad-mode",
   "cli": {
    "argv": [
     "gsc-query",
     "--site-url",
     "sc-domain:example.test",
     "--mode",
     "nope"
    ]
   },
   "expect": {
    "cli": {
     "exit": 2,
     "stdout": "",
     "stderr": "usage: spiderhead gsc-query [-h] [--input INPUT] [--site-url SITE_URL]\n                            [--mode {search_analytics,inspect_url}]\n                            [--start-date START_DATE] [--end-date END_DATE]\n                            [--dimensions DIMENSIONS] [--row-limit ROW_LIMIT]\n                            [--inspection-url INSPECTION_URL]\nspiderhead gsc-query: error: argument --mode: invalid choice: 'nope' (choose from 'search_analytics', 'inspect_url')\n",
     "requests": []
    }
   }
  },
  {
   "name": "gsc-no-site",
   "cli": {
    "argv": [
     "gsc-query",
     "--site-url",
     ""
