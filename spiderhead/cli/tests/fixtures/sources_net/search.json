{
 "group": "search",
 "cases": [
  {
   "name": "gsc-analytics",
   "cli": {
    "argv": [
     "gsc-query",
     "--site-url",
     "sc-domain:example.test",
     "--start-date",
     "2026-01-01",
     "--end-date",
     "2026-01-28",
     "--dimensions",
     "query,page",
     "--row-limit",
     "50"
    ]
   },
   "mcp": {
    "tool": "seo_gsc_query",
    "arguments": {
     "site_url": "sc-domain:example.test",
     "start_date": "2026-01-01",
     "end_date": "2026-01-02"
    }
   },
   "seed": [
    {
     "path": ".config/gsc/access_token",
     "text": "test-gsc-token"
    }
   ],
   "routes": [
    {
     "host": "www.googleapis.com",
     "method": "POST",
     "path": "/webmasters/v3/sites/sc-domain%3Aexample.test/searchAnalytics/query",
     "responses": [
      {
       "status": 200,
       "headers": {
        "content-type": "application/json"
       },
       "body": {
        "rows": [
         {
          "keys": [
           "seo audit"
          ],
          "clicks": 12,
          "impressions": 340,
          "ctr": 0.0353,
          "position": 4.2
         },
         {
          "keys": [
           "sitemap check"
          ],
          "clicks": 3,
          "impressions": 90,
          "ctr": 0.0333,
          "position": 8.7
         }
        ]
       }
      }
     ]
    }
   ],
   "expect": {
    "cli": {
     "exit": 0,
     "stdout": "{\n  \"ok\": true,\n  \"site_url\": \"sc-domain:example.test\",\n  \"period\": \"2026-01-01..2026-01-28\",\n  \"count\": 2,\n  \"rows\": [\n    {\n      \"keys\": [\n        \"seo audit\"\n      ],\n      \"clicks\": 12,\n      \"impressions\": 340,\n      \"ctr\": 0.0353,\n      \"position\": 4.2\n    },\n    {\n      \"keys\": [\n        \"sitemap check\"\n      ],\n      \"clicks\": 3,\n      \"impressions\": 90,\n      \"ctr\": 0.0333,\n      \"position\": 8.7\n    }\n  ]\n}\n",
     "stderr": "seohead: gsc-query\n",
     "requests": [
      {
       "host": "www.googleapis.com",
       "method": "POST",
       "path": "/webmasters/v3/sites/sc-domain%3Aexample.test/searchAnalytics/query",
       "query": "",
       "body": "{\"startDate\": \"2026-01-01\", \"endDate\": \"2026-01-28\", \"dimensions\": [\"query\", \"page\"], \"rowLimit\": 50}",
       "headers": {
        "authorization": "Bearer test-gsc-token",
        "content-type": "application/json"
       }
      }
     ]
    },
    "mcp": {
     "is_error": false,
     "text": "{\n  \"ok\": true,\n  \"site_url\": \"sc-domain:example.test\",\n  \"period\": \"2026-01-01..2026-01-02\",\n  \"count\": 2,\n  \"rows\": [\n    {\n      \"keys\": [\n        \"seo audit\"\n      ],\n      \"clicks\": 12,\n      \"impressions\": 340,\n      \"ctr\": 0.0353,\n      \"position\": 4.2\n    },\n    {\n      \"keys\": [\n        \"sitemap check\"\n      ],\n      \"clicks\": 3,\n      \"impressions\": 90,\n      \"ctr\": 0.0333,\n      \"position\": 8.7\n    }\n  ]\n}",
     "requests": [
      {
       "host": "www.googleapis.com",
       "method": "POST",
       "path": "/webmasters/v3/sites/sc-domain%3Aexample.test/searchAnalytics/query",
       "query": "",
       "body": "{\"startDate\": \"2026-01-01\", \"endDate\": \"2026-01-02\", \"dimensions\": [\"query\"], \"rowLimit\": 1000}",
       "headers": {
        "authorization": "Bearer test-gsc-token",
        "content-type": "application/json"
       }
      }
     ]
    }
   }
  },
