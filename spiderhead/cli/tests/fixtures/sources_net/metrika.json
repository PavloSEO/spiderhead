{
 "group": "metrika",
 "cases": [
  {
   "name": "counters-ok",
   "cli": {
    "argv": [
     "metrika-counters"
    ]
   },
   "mcp": {
    "tool": "seo_metrika_counters",
    "arguments": {}
   },
   "seed": [
    {
     "path": ".config/yandex-metrika/token",
     "text": "test-metrika-token"
    }
   ],
   "routes": [
    {
     "host": "api-metrika.yandex.net",
     "method": "GET",
     "path": "/management/v1/counters",
     "responses": [
      {
       "status": 200,
       "headers": {
        "content-type": "application/json"
       },
       "body": {
        "counters": [
         {
          "id": 101,
          "name": "Main",
          "site": "example.test",
          "status": "Active",
          "extra": 1
         },
         {
          "id": 102,
          "name": "Blog",
          "site": "blog.example.test",
          "status": "Active"
         }
        ]
       }
      }
     ]
    }
   ],
   "expect": {
    "cli": {
     "exit": 0,
     "stdout": "{\n  \"ok\": true,\n  \"count\": 2,\n  \"counters\": [\n    {\n      \"id\": 101,\n      \"name\": \"Main\",\n      \"site\": \"example.test\",\n      \"status\": \"Active\"\n    },\n    {\n      \"id\": 102,\n      \"name\": \"Blog\",\n      \"site\": \"blog.example.test\",\n      \"status\": \"Active\"\n    }\n  ]\n}\n",
     "stderr": "seohead: metrika-counters\n",
     "requests": [
      {
       "host": "api-metrika.yandex.net",
       "method": "GET",
       "path": "/management/v1/counters",
       "query": "",
       "body": "",
       "headers": {
        "authorization": "OAuth test-metrika-token"
       }
      }
     ]
    },
    "mcp": {
     "is_error": false,
     "text": "{\n  \"ok\": true,\n  \"count\": 2,\n  \"counters\": [\n    {\n      \"id\": 101,\n      \"name\": \"Main\",\n      \"site\": \"example.test\",\n      \"status\": \"Active\"\n    },\n    {\n      \"id\": 102,\n      \"name\": \"Blog\",\n      \"site\": \"blog.example.test\",\n      \"status\": \"Active\"\n    }\n  ]\n}",
