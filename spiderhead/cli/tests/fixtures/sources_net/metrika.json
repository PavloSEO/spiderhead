  {
   "name": "report-ok",
   "cli": {
    "argv": [
     "metrika-report",
     "--counter",
     "101",
     "--metrics",
     "ym:s:visits,ym:s:pageviews",
     "--dimensions",
     "ym:s:startURL",
     "--date1",
     "2026-01-01",
     "--date2",
     "2026-01-31",
     "--limit",
     "50",
     "--sort=-ym:s:visits"
    ]
   },
   "mcp": {
    "tool": "seo_metrika_report",
    "arguments": {
     "counter_id": "101",
     "metrics": "ym:s:visits",
     "date1": "7daysAgo"
    }
   },
   "seed": [
    {
     "path": ".config/yandex-metrika/token",
     "text": "test-metrika-token"
    }
   ],
   "routes": [
    {
     "host": "api-metrika.yandex.net",
     "method": "GET",
     "path": "/stat/v1/data",
     "responses": [
      {
       "status": 200,
       "headers": {
        "content-type": "application/json"
       },
       "body": {
        "query": {
         "dimensions": [
          "ym:s:startURL"
         ],
         "metrics": [
          "ym:s:visits",
          "ym:s:pageviews"
         ],
         "accuracy": "full"
        },
        "data": [
         {
          "dimensions": [
           {
            "name": "https://example.test/"
           }
          ],
          "metrics": [
           120,
           340
          ]
         },
         {
          "dimensions": [
           {
            "name": "https://example.test/a"
           }
          ],
          "metrics": [
           30,
           41
          ]
         }
        ],
        "total_rows": 2,
        "sampled": false,
        "sample_share": 1.0,
        "totals": [
         150,
         381
        ]
       }
      }
     ]
    }
   ],
   "expect": {
    "cli": {
     "exit": 0,
     "stdout": "{\n  \"ok\": true,\n  \"counter_id\": \"101\",\n  \"period\": \"2026-01-01..2026-01-31\",\n  \"total_rows\": 2,\n  \"returned\": 2,\n  \"capped\": false,\n  \"incomplete\": false,\n  \"sampled\": false,\n  \"sample_share\": 1.0,\n  \"accuracy\": \"full\",\n  \"split\": null,\n  \"totals\": [\n    150,\n    381\n  ],\n  \"rows\": [\n    {\n      \"startURL\": \"https://example.test/\",\n      \"visits\": 120,\n      \"pageviews\": 340\n    },\n    {\n      \"startURL\": \"https://example.test/a\",\n      \"visits\": 30,\n      \"pageviews\": 41\n    }\n  ]\n}\n",
     "stderr": "seohead: metrika-report\n",
     "requests": [
      {
       "host": "api-metrika.yandex.net",
       "method": "GET",
       "path": "/stat/v1/data",
       "query": "accuracy=full&ids=101&metrics=ym%3As%3Avisits%2Cym%3As%3Apageviews&date1=2026-01-01&date2=2026-01-31&dimensions=ym%3As%3AstartURL&sort=-ym%3As%3Avisits&limit=50&offset=1",
       "body": "",
       "headers": {
        "authorization": "OAuth test-metrika-token"
       }
      }
     ]
    },
    "mcp": {
     "is_error": false,
     "text": "{\n  \"ok\": true,\n  \"counter_id\": \"101\",\n  \"period\": \"7daysAgo..today\",\n  \"total_rows\": 2,\n  \"returned\": 2,\n  \"capped\": false,\n  \"incomplete\": false,\n  \"sampled\": false,\n  \"sample_share\": 1.0,\n  \"accuracy\": \"full\",\n  \"split\": null,\n  \"totals\": [\n    150,\n    381\n  ],\n  \"rows\": [\n    {\n      \"startURL\": \"https://example.test/\",\n      \"visits\": 120,\n      \"pageviews\": 340\n    },\n    {\n      \"startURL\": \"https://example.test/a\",\n      \"visits\": 30,\n      \"pageviews\": 41\n    }\n  ]\n}",
     "requests": [
      {
       "host": "api-metrika.yandex.net",
       "method": "GET",
       "path": "/stat/v1/data",
       "query": "accuracy=full&ids=101&metrics=ym%3As%3Avisits&date1=7daysAgo&date2=today&limit=100&offset=1",
       "body": "",
       "headers": {
        "authorization": "OAuth test-metrika-token"
       }
      }
     ]
    }
   }
