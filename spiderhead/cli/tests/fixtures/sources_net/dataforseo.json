{
 "group": "dataforseo",
 "cases": [
  {
   "name": "estimate-sandbox",
   "cli": {
    "argv": [
     "dataforseo-estimate",
     "--operation",
     "search_volume",
     "--query-count",
     "3"
    ]
   },
   "mcp": {
    "tool": "seo_dataforseo_estimate",
    "arguments": {
     "operation": "serp",
     "query_count": 2,
     "row_limit": 20
    }
   },
   "expect": {
    "cli": {
     "exit": 0,
     "stdout": "{\n  \"ok\": true,\n  \"operation\": \"search_volume\",\n  \"env\": \"sandbox\",\n  \"currency\": \"USD\",\n  \"query_count\": 3,\n  \"cache_hits\": 0,\n  \"cache_basis\": \"caller_declared\",\n  \"billable_queries\": 3,\n  \"row_limit\": 0,\n  \"cost_usd\": 0.0,\n  \"state\": \"complete\",\n  \"reason\": \"sandbox or cached data incurs no new charge\"\n}\n",
     "stderr": "seohead: dataforseo-estimate\n",
     "requests": []
    },
    "mcp": {
     "is_error": false,
     "text": "{\n  \"ok\": true,\n  \"operation\": \"serp\",\n  \"env\": \"sandbox\",\n  \"currency\": \"USD\",\n  \"query_count\": 2,\n  \"cache_hits\": 0,\n  \"cache_basis\": \"caller_declared\",\n  \"billable_queries\": 2,\n  \"row_limit\": 20,\n  \"cost_usd\": 0.0,\n  \"state\": \"complete\",\n  \"reason\": \"sandbox or cached data incurs no new charge\"\n}",
     "requests": []
    }
   }
  },
