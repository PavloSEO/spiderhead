 "tools": [
  {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
   },
   "description": "Fetch and analyze a site's robots.txt: user-agent groups, declared\nsitemaps, and whether given paths are crawlable.",
   "inputSchema": {
    "properties": {
     "paths": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Paths"
     },
     "url": {
      "title": "Url",
      "type": "string"
     },
     "user_agent": {
      "default": "*",
      "title": "User Agent",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "title": "seo_robots_checkArguments",
    "type": "object"
   },
   "name": "seo_robots_check",
   "outputSchema": {
    "$defs": {
     "RobotsCheckError": {
      "description": "`robots.check_robots` when fetching robots.txt itself failed.",
      "properties": {
       "error": {
        "title": "Error",
        "type": "string"
       },
       "ok": {
        "const": false,
        "title": "Ok",
        "type": "boolean"
       },
       "robots_url": {
        "title": "Robots Url",
        "type": "string"
       },
       "status_code": {
        "title": "Status Code",
        "type": "integer"
       }
      },
      "required": [
       "ok",
       "robots_url",
       "error"
      ],
      "title": "RobotsCheckError",
      "type": "object"
     },
     "RobotsCheckFound": {
      "description": "`robots.check_robots` once the robots.txt request itself succeeded\n(whether or not a robots.txt actually exists \u2014 see `exists`).",
      "properties": {
       "exists": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "title": "Exists"
       },
       "groups": {
        "items": {
         "$ref": "#/$defs/RobotsGroup"
        },
        "title": "Groups",
        "type": "array"
       },
       "note": {
        "title": "Note",
        "type": "string"
       },
       "ok": {
        "const": true,
        "title": "Ok",
        "type": "boolean"
       },
       "path_checks": {
        "items": {
         "$ref": "#/$defs/RobotsPathCheck"
        },
        "title": "Path Checks",
        "type": "array"
       },
       "robots_url": {
        "title": "Robots Url",
        "type": "string"
       },
       "sitemaps": {
        "items": {
         "type": "string"
        },
        "title": "Sitemaps",
        "type": "array"
       },
       "state": {
        "title": "State",
        "type": "string"
       },
       "status_code": {
        "title": "Status Code",
        "type": "integer"
       }
      },
      "required": [
       "ok",
       "robots_url",
       "status_code",
       "exists",
       "groups",
       "sitemaps"
      ],
      "title": "RobotsCheckFound",
      "type": "object"
     },
     "RobotsGroup": {
      "description": "One `User-agent:` group from a parsed robots.txt.",
      "properties": {
       "_line_of": {
        "additionalProperties": {
         "type": "integer"
        },
        "title": "Line Of",
        "type": "object"
       },
       "allow": {
        "items": {
         "type": "string"
        },
        "title": "Allow",
        "type": "array"
       },
       "crawl_delay": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "title": "Crawl Delay"
       },
       "disallow": {
        "items": {
         "type": "string"
        },
        "title": "Disallow",
        "type": "array"
       },
       "request_rate_delay": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "title": "Request Rate Delay"
       },
       "user_agents": {
        "items": {
         "type": "string"
        },
        "title": "User Agents",
        "type": "array"
       }
      },
      "required": [
       "user_agents",
       "allow",
       "disallow",
       "crawl_delay",
       "request_rate_delay",
       "_line_of"
      ],
      "title": "RobotsGroup",
      "type": "object"
     },
     "RobotsPathCheck": {
      "properties": {
       "allowed": {
        "title": "Allowed",
        "type": "boolean"
       },
       "path": {
        "title": "Path",
        "type": "string"
       }
      },
      "required": [
       "path",
       "allowed"
      ],
      "title": "RobotsPathCheck",
      "type": "object"
     }
    },
    "properties": {
     "result": {
      "anyOf": [
       {
        "$ref": "#/$defs/RobotsCheckFound"
       },
       {
        "$ref": "#/$defs/RobotsCheckError"
       }
      ],
      "title": "Result"
     }
    },
    "required": [
     "result"
    ],
    "title": "seo_robots_checkOutput",
    "type": "object"
   }
  },
