  {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
   },
   "description": "Audit a site's regional structure: subdomains (msk.site.ru), folders\n(site.ru/msk/) and satellite domains (site-msk.ru). Finds the city switcher on the\npage, recognises ~100 Russian cities by URL slug (msk/moskva/moscow all collapse to\none region) and by Cyrillic anchor text, then fetches each regional page and reports\nwhat actually kills regional promotion: hosts that just redirect to the main domain\n(so the region does not exist), regional pages canonicalised to another host\n(self-removal from the index), noindex, identical content across cities, one shared\nphone number for the whole country, a missing city name in the title, and two\nschemes used at once. Satellite domains are invisible from the page \u2014 pass them in\n`extra`. Set render=true when the city switcher is drawn by JavaScript (needs\nPlaywright) \u2014 on many large sites it is not in the raw HTML at all.",
   "inputSchema": {
    "properties": {
     "extra": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Extra"
     },
     "limit": {
      "default": 12,
      "title": "Limit",
      "type": "integer"
     },
     "render": {
      "default": false,
      "title": "Render",
      "type": "boolean"
     },
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "title": "seo_regions_checkArguments",
    "type": "object"
   },
   "name": "seo_regions_check",
   "outputSchema": {
    "additionalProperties": true,
    "title": "seo_regions_checkDictOutput",
    "type": "object"
   }
  },
