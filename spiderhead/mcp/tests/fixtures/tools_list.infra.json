     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "title": "seo_sitemap_crawlArguments",
    "type": "object"
   },
   "name": "seo_sitemap_crawl",
   "outputSchema": {
    "additionalProperties": true,
    "title": "seo_sitemap_crawlDictOutput",
    "type": "object"
   }
  },
