  {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
   },
   "description": "Validate a page's structured data in two layers. Layer one is the Schema.org\nvocabulary itself (1010 types, 1676 properties, shipped with the toolkit): does\nthe type exist, is the property allowed on it once inheritance is resolved, does\nthe value type match, is the term deprecated or still in the pending layer.\nLayer two is Google rich-result eligibility per type. Also analyses the JSON-LD\nas a GRAPH: which entities carry @id, which are linked, which hang as islands,\nand whether any @id reference dangles. Pass html to check markup offline.",
   "inputSchema": {
    "properties": {
     "html": {
      "default": "",
      "title": "Html",
      "type": "string"
     },
     "url": {
      "default": "",
      "title": "Url",
      "type": "string"
     }
    },
    "title": "seo_schema_checkArguments",
    "type": "object"
   },
   "name": "seo_schema_check",
   "outputSchema": {
    "additionalProperties": true,
    "title": "seo_schema_checkDictOutput",
    "type": "object"
   }
  },
  {
