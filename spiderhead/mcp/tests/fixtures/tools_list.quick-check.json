     "TrustSignal": {
      "description": "One objective authorship/date markup observation (issue #823).\n\n``signal`` names the carrier exactly -- e.g. ``meta_author``,\n``jsonld_date:datePublished``, ``time_element``, ``url_path_date`` -- so an\nauditor can review which markup produced the evidence rather than trusting a\nblended verdict. ``confidence`` is ``high`` for an explicit machine-readable\ndeclaration and ``medium`` for a conventional carrier (a ``byline`` class, a\n``<time>`` element, a date-shaped URL path). ``value`` is the declared\nstring the markup carried (an author name, a datetime, the matched path\nfragment), truncated by the parser; ``\"\"`` when the carrier holds no value.",
      "properties": {
       "confidence": {
        "title": "Confidence",
        "type": "string"
       },
       "signal": {
        "title": "Signal",
        "type": "string"
       },
       "value": {
        "title": "Value",
        "type": "string"
       }
      },
      "required": [
       "signal",
       "confidence",
       "value"
      ],
      "title": "TrustSignal",
      "type": "object"
     },
     "TrustSignals": {
      "description": "A page's authorship/date/article-scope markup evidence (issue #823).\n\nAn empty list is a measured absence: the page was parsed and declared no\nsuch signal. ``article`` holds the markers that place the page in the\nauthorship checks' scope (a JSON-LD article ``@type``, ``og:type=article``,\nan ``<article>`` element) -- the page declaring itself content-shaped, which\nis a fact about its markup, never a judgement about its quality.",
      "properties": {
       "article": {
        "items": {
         "type": "string"
        },
        "title": "Article",
        "type": "array"
       },
       "author": {
        "items": {
         "$ref": "#/$defs/TrustSignal"
        },
        "title": "Author",
        "type": "array"
       },
       "dates": {
        "items": {
         "$ref": "#/$defs/TrustSignal"
        },
        "title": "Dates",
        "type": "array"
       }
      },
      "required": [
       "author",
       "dates",
       "article"
      ],
      "title": "TrustSignals",
      "type": "object"
     }
    },
