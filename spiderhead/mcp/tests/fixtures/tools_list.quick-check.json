       }
      ],
      "default": null,
      "title": "Config Path"
     },
     "projects_directory": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Projects Directory"
     },
     "sf_cli": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Sf Cli"
     }
    },
    "title": "seo_doctorArguments",
    "type": "object"
   },
   "name": "seo_doctor",
   "outputSchema": {
