  {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true
   },
   "description": "Parse SEO data (title, meta description, canonical, OG/Twitter, H1-H6,\nJSON-LD, links, visible text, word count) from one URL or a list of URLs.",
   "inputSchema": {
    "properties": {
     "options": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Options"
     },
     "url": {
      "default": "",
      "title": "Url",
      "type": "string"
     },
     "urls": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Urls"
     }
    },
    "title": "seo_parseArguments",
    "type": "object"
   },
   "name": "seo_parse",
   "outputSchema": {
    "$defs": {
     "DocumentPosition": {
      "description": "Where key elements sit relative to `<head>`, as `parser.parse_html`'s\nparse tree resolved them -- not as the source text suggests (issue #123).\n\nA browser closes `<head>` at the first element that does not belong there,\nso a canonical or robots directive placed after one silently stops\napplying; the page still reads fine in the source. Each `*_outside_head`\nflag is `None` when the element is simply absent -- a different, already\ncovered finding -- and a bool only once it exists.",
      "properties": {
       "body_count": {
        "title": "Body Count",
        "type": "integer"
       },
       "canonical_outside_head": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "title": "Canonical Outside Head"
       },
       "directives_outside_head": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "title": "Directives Outside Head"
       },
       "head_count": {
        "title": "Head Count",
        "type": "integer"
       },
       "head_not_first": {
        "title": "Head Not First",
        "type": "boolean"
       },
       "hreflang_outside_head": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "title": "Hreflang Outside Head"
       },
       "invalid_head_elements": {
        "items": {
         "type": "string"
        },
        "title": "Invalid Head Elements",
        "type": "array"
       },
       "meta_description_outside_head": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "title": "Meta Description Outside Head"
       },
       "title_outside_head": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "title": "Title Outside Head"
       }
      },
      "required": [
       "head_count",
       "body_count",
       "head_not_first",
       "invalid_head_elements",
       "title_outside_head",
       "meta_description_outside_head",
       "canonical_outside_head",
       "directives_outside_head",
       "hreflang_outside_head"
      ],
      "title": "DocumentPosition",
      "type": "object"
     },
     "DuplicateId": {
      "description": "One repeated HTML id value and its observed occurrence count.",
      "properties": {
       "count": {
        "title": "Count",
        "type": "integer"
       },
       "id": {
        "title": "Id",
        "type": "string"
       }
      },
      "required": [
       "id",
       "count"
      ],
      "title": "DuplicateId",
      "type": "object"
     },
     "FormInfo": {
      "description": "One `<form>` extracted from a page (issue #125).",
      "properties": {
       "action": {
        "title": "Action",
        "type": "string"
       },
       "has_password": {
        "title": "Has Password",
        "type": "boolean"
       },
       "method": {
        "title": "Method",
        "type": "string"
       }
      },
      "required": [
       "method",
       "action",
       "has_password"
      ],
      "title": "FormInfo",
      "type": "object"
     },
     "FrameInfo": {
      "description": "One `<iframe>` extracted from a page (issue #360).\n\nA framed document is not part of the parent DOM, so every text-derived\nmeasurement -- word count, headings, the content area -- describes the shell\naround the content rather than the content. Recording what a page frames is\nwhat lets a check say \"the copy is in an iframe\" instead of \"this page is\nthin\", which is the same fact read the wrong way round.",
      "properties": {
       "in_content_area": {
        "title": "In Content Area",
        "type": "boolean"
       },
       "loading": {
        "title": "Loading",
        "type": "string"
       },
       "raw_src": {
        "title": "Raw Src",
        "type": "string"
       },
       "same_origin": {
        "title": "Same Origin",
        "type": "boolean"
       },
       "sandbox": {
        "title": "Sandbox",
        "type": "string"
       },
       "src": {
        "title": "Src",
        "type": "string"
       },
       "title": {
        "title": "Title",
        "type": "string"
       }
      },
      "required": [
       "src",
       "raw_src",
       "same_origin",
       "in_content_area",
       "title",
       "loading",
       "sandbox"
      ],
      "title": "FrameInfo",
      "type": "object"
     },
     "HeadingLinkRef": {
      "description": "One anchor wrapped in an `<h1>`-`<h6>` (issue #634).\n\n``level`` is the *nearest* heading ancestor's level, which is what a reader\nsees; ``anchor`` is the link's own collapsed text, which on this defect is\nusually the whole heading.",
      "properties": {
       "anchor": {
        "title": "Anchor",
        "type": "string"
       },
       "destination": {
        "title": "Destination",
        "type": "string"
       },
       "level": {
        "title": "Level",
        "type": "integer"
       }
      },
      "required": [
       "level",
       "destination",
       "anchor"
      ],
      "title": "HeadingLinkRef",
      "type": "object"
     },
     "HeadingRef": {
      "description": "One `<h1>`-`<h6>` in document order, with where on the page it sits (issue #632).\n\n``level`` and ``text`` are what the eight existing heading checks read as an\nunordered set; keeping them in a sequence is what lets a check ask whether a\nheading precedes the page's first H1. ``region`` reuses the link-position\ntaxonomy (``seohead.checks.link_position.POSITIONS``) so \"in the header\"\nmeans the same thing about a heading as it already does about a link, and is\n``\"\"`` when the document offered nothing to place the heading against --\nunmeasured, which is neither chrome nor content.",
      "properties": {
       "level": {
        "title": "Level",
        "type": "integer"
       },
       "region": {
        "title": "Region",
        "type": "string"
       },
       "text": {
        "title": "Text",
        "type": "string"
       }
      },
      "required": [
       "level",
       "text",
       "region"
      ],
      "title": "HeadingRef",
      "type": "object"
     },
     "HreflangAlternate": {
      "description": "One `<link rel=\"alternate\" hreflang=\"...\">` declaration (issue #357).\n\nThe code and the href are kept exactly as the document wrote them: a code\nwith the wrong case or a malformed region is itself a finding, and\nnormalising on capture would hide it. ``url`` is that same href resolved\nagainst the document base -- what a browser does -- so a reciprocity check\ncan compare targets without the original being lost.",
      "properties": {
       "lang": {
        "title": "Lang",
        "type": "string"
       },
       "raw_href": {
        "title": "Raw Href",
        "type": "string"
       },
       "url": {
        "title": "Url",
        "type": "string"
       }
      },
      "required": [
       "lang",
       "raw_href",
       "url"
      ],
      "title": "HreflangAlternate",
      "type": "object"
     },
     "ImageInfo": {
      "description": "One `<img>` as the coverage checks need it (issues #385, #386).\n\n``has_alt`` is whether the attribute is present at all, which is a different\nfact from its length: ``alt=\"\"`` is a deliberate mark on a decorative image\nand must stay silent, while a missing attribute is the finding. Collapsing\nthe two into one truthy value is how a correctly marked-up site gets told to\nadd alt text it already declined on purpose.",
      "properties": {
       "alt_length": {
        "title": "Alt Length",
        "type": "integer"
       },
       "has_alt": {
        "title": "Has Alt",
        "type": "boolean"
       }
      },
      "required": [
       "has_alt",
       "alt_length"
      ],
      "title": "ImageInfo",
      "type": "object"
     },
     "ImageLinkRef": {
      "description": "One image link that names nothing about where it goes (issue #634).",
      "properties": {
       "destination": {
        "title": "Destination",
        "type": "string"
       }
      },
      "required": [
       "destination"
      ],
      "title": "ImageLinkRef",
      "type": "object"
     },
     "InvalidLinkTarget": {
      "description": "One href the parser rejected, exactly as written plus the reason.",
      "properties": {
       "raw_href": {
        "title": "Raw Href",
        "type": "string"
       },
       "reason": {
        "title": "Reason",
        "type": "string"
       }
      },
      "required": [
       "raw_href",
       "reason"
      ],
      "title": "InvalidLinkTarget",
      "type": "object"
     },
     "LinkInfo": {
      "description": "One `<a href>` extracted from a page.",
      "properties": {
       "anchor_source": {
        "title": "Anchor Source",
        "type": "string"
       },
       "external": {
        "title": "External",
        "type": "boolean"
       },
       "href": {
        "title": "Href",
        "type": "string"
       },
       "nofollow": {
        "title": "Nofollow",
        "type": "boolean"
       },
       "position": {
        "title": "Position",
        "type": "string"
       },
       "raw_href": {
        "title": "Raw Href",
        "type": "string"
       },
       "rel": {
        "title": "Rel",
        "type": "string"
       },
       "target": {
        "title": "Target",
